// ==============================================================================
// AROGYANEXUS — Prisma Schema for Local PostgreSQL Database
// Tables: users, doctor_profiles
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  full_name     String
  email         String         @unique
  password_hash String
  phone         String?
  role          String         @default("patient") // Allowed: 'patient' | 'doctor' | 'admin'
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  doctor_profile DoctorProfile?
  appointments   Appointment[]
  profiles       Profile[]
  uploaded_health_records HealthRecord[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model DoctorProfile {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  speciality          String
  registration_number String   @unique
  clinic_name         String
  clinic_address      String
  consultation_fee    Decimal  @db.Decimal(10, 2)
  status              String   @default("pending") // Allowed: 'pending' | 'approved' | 'rejected'
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointments Appointment[]
  photo_url String?
  verified Boolean @default(false)
  clinic_lat Float?
  clinic_lng Float?
  experience_years Int?
  languages String[] @default([])
  bio String?
  offers_video Boolean @default(true)
  rating_avg Float @default(0)
  rating_count Int @default(0)
  health_records HealthRecord[]
  assigned_record_reviews HealthRecord[] @relation("AssignedDoctorReviews")
  completed_record_reviews HealthRecord[] @relation("CompletedDoctorReviews")
  access_logs AccessLog[]
  visit_records VisitRecord[]

  @@index([user_id])
  @@index([status])
  @@index([registration_number])
  @@map("doctor_profiles")
}

model Appointment {
  id                String   @id @default(uuid())
  patient_id        String
  profile_id        String?
  doctor_profile_id String
  appointment_at    DateTime
  reason            String?
  status            String   @default("pending")
  created_at        DateTime @default(now())
  ends_at           DateTime?
  mode              String @default("IN_PERSON")
  cancel_reason     String?
  notes             String?
  seed_key          String? @unique
  token_number      Int?
  checked_in_at     DateTime?
  check_in_vitals   Json?
  missed_alert_sent_at DateTime?
  proposed_starts_at DateTime?
  cancelled_by      String?
  updated_at        DateTime @default(now()) @updatedAt

  patient User @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  DoctorProfile @relation(fields: [doctor_profile_id], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  visit_record VisitRecord?

  @@index([patient_id, appointment_at])
  @@index([doctor_profile_id, appointment_at])
  @@map("appointments")
}

model Profile {
  id String @id @default(uuid())
  user_id String
  name String
  relation String @default("SELF")
  seed_key String? @unique
  allergies String[] @default([])
  dob DateTime?
  gender String?
  blood_group String?
  phone String?
  height_cm Float?
  weight_kg Float?
  emergency_name String?
  emergency_phone String?
  emergency_relation String?
  allergies_confirmed Boolean @default(false)
  onboarding_step Int @default(0)
  onboarded_at DateTime?
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointments Appointment[]
  access ProfileAccess[]
  health_records HealthRecord[]
  vital_readings VitalReading[]
  conditions PatientCondition[]
  access_logs AccessLog[]
  visit_records VisitRecord[]

  @@index([user_id])
  @@map("profiles")
}

model HealthRecord {
  id String @id @default(uuid())
  patient_id String
  category String
  title String
  issuer String
  record_date DateTime
  doctor_id String?
  uploaded_by String
  source String
  file_key String @unique
  file_name String
  mime_type String
  size_bytes Int
  tags String[] @default([])
  created_at DateTime @default(now())
  deleted_at DateTime?
  seed_key String? @unique

  // Document Verification Fields
  verification_status   String    @default("PENDING") // PENDING, AI_VERIFIED, DOCTOR_REVIEW_REQUIRED, DOCTOR_REVIEW_PENDING, DOCTOR_VERIFIED, REJECTED
  verification_method   String?   // 'AI' | 'DOCTOR'
  ai_confidence         Float?
  ai_extracted_fields   Json?     // { patientName, issuer, recordDate, documentType, summary }
  ai_verified_at        DateTime?
  review_requested_at   DateTime?
  assigned_doctor_id    String?
  reviewed_by_doctor_id String?
  doctor_reviewed_at    DateTime?
  rejection_reason      String?
  doctor_review_notes   String?

  patient Profile @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor DoctorProfile? @relation(fields: [doctor_id], references: [id], onDelete: SetNull)
  assigned_doctor DoctorProfile? @relation("AssignedDoctorReviews", fields: [assigned_doctor_id], references: [id], onDelete: SetNull)
  reviewed_by_doctor DoctorProfile? @relation("CompletedDoctorReviews", fields: [reviewed_by_doctor_id], references: [id], onDelete: SetNull)
  uploader User @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  access_logs AccessLog[]

  @@index([patient_id, record_date])
  @@index([patient_id, category, record_date])
  @@index([patient_id, verification_status])
  @@index([assigned_doctor_id, verification_status])
  @@map("health_records")
}

model VitalReading {
  id String @id @default(uuid())
  patient_id String
  type String
  value Float
  unit String
  measured_at DateTime
  source String @default("SELF")
  seed_key String? @unique
  patient Profile @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  @@index([patient_id, type, measured_at])
  @@map("vital_readings")
}

model PatientCondition {
  id String @id @default(uuid())
  patient_id String
  name String
  status String @default("ACTIVE")
  since DateTime?
  seed_key String? @unique
  patient Profile @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  @@index([patient_id, status])
  @@map("patient_conditions")
}

model AccessLog {
  id String @id @default(uuid())
  patient_id String
  doctor_id String
  action String
  record_id String?
  record_title String?
  consent_id String?
  created_at DateTime @default(now())
  patient Profile @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor DoctorProfile @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  record HealthRecord? @relation(fields: [record_id], references: [id], onDelete: SetNull)
  @@index([patient_id, created_at])
  @@map("access_logs")
}

model ProfileAccess {
  id String @id @default(uuid())
  profile_id String
  user_id String
  level String @default("OWNER")
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  @@unique([profile_id, user_id])
  @@map("profile_access")
}

model VisitRecord {
  id String @id @default(uuid())
  appointment_id String @unique
  prescription_file_key String?
  report_file_key String?
  profile_id String?
  doctor_profile_id String?
  diagnosis String?
  notes String?
  tests_advised String?
  follow_up_date DateTime?
  finalized_at DateTime?
  created_at DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  doctor DoctorProfile? @relation(fields: [doctor_profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([doctor_profile_id])
  @@map("visit_records")
}
