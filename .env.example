# ==============================================================================
# AROGYANEXUS — Local PostgreSQL Environment Variables
# Copy this file to .env and configure your local PostgreSQL credentials
# ==============================================================================

# PostgreSQL local connection string
DATABASE_URL=postgresql://arogyanexus:arogyanexus@localhost:5432/arogyanexus?schema=public
DIRECT_URL=postgresql://arogyanexus:arogyanexus@localhost:5432/arogyanexus?schema=public

# Optional seed overrides. All default accounts and content are fictional.
DEMO_PASSWORD=Pass@123
DEMO_PATIENT_EMAIL=patient@arogyanexus.test

# Server Session Secret for signing/verifying HTTP-only session cookies
SESSION_SECRET=replace_with_a_long_random_secret

# Local Backend API Port
PORT=3001
VITE_ORIGIN=http://localhost:5173
