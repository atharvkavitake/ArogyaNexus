# ==============================================================================
# AROGYANEXUS — Local PostgreSQL Environment Variables
# Copy this file to .env and configure your local PostgreSQL credentials
# ==============================================================================

# PostgreSQL local connection string
DATABASE_URL=postgresql://username:password@localhost:5432/arogyanexus

# Server Session Secret for signing/verifying HTTP-only session cookies
SESSION_SECRET=replace_with_a_long_random_secret

# Local Backend API Port
PORT=3001

# ==============================================================================
# Document Verification & Clinical AI Configuration
# ==============================================================================
# Google Gemini API keys with multi-key rotation and automatic limit fallback
# If Key 1 reaches its limit, Key 2 is automatically called, then Key 3
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
GEMINI_API_KEY_3=your_tertiary_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3

# Minimum confidence required for AI_VERIFIED status (0.0 to 1.0, default: 0.80)
DOCUMENT_VERIFICATION_MIN_CONFIDENCE=0.80

# Verification timeout in milliseconds before failing over to doctor review
DOCUMENT_VERIFICATION_TIMEOUT_MS=12000

# Security: Set to 'false' to disable development authentication fallbacks
ALLOW_DEV_AUTH=false

# Maximum allowed document upload size in bytes (10MB default)
MAX_DOCUMENT_SIZE_BYTES=10485760

